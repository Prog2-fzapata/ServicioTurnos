TURNOS_DB_NAME=turnos_db
TURNOS_DB_USER=turnos_user
TURNOS_DB_PASSWORD=cambiar

POSTGRES_PORT=5433
TURNOS_PORT=8082

# Clave HMAC del JWT en Base64: debe ser el mismo valor que JWT_SECRET en el .env de catálogo.
JWT_SECRET=cambiar

# URL del servicio de catálogo. Desde el contenedor se llega por el host, donde catálogo publica su puerto.
# Para ejecutar con Maven fuera de Docker usar http://localhost:8081
CATALOGO_BASE_URL=http://host.docker.internal:8081

# Cátedra: URL base de su API (sin "/" final) y JWT técnico (el id_token que devuelve su POST /api/authenticate).
# Es la misma cuenta técnica que usa catálogo: copiar ambos valores de su .env. Son obligatorias: sin ellas el servicio no arranca.
CATEDRA_BASE_URL=cambiar
CATEDRA_JWT=cambiar

# Kafka de la cátedra: los tres salen de la respuesta de "integration" (kafkaBootstrapServers, kafkaConsumerGroupId y
# kafkaAppointmentActionsTopic). Son obligatorias. El servidor es la IP de ZeroTier, no el host interno que informa la API.
# Son los mismos valores del .env de catálogo, salvo el topic
CATEDRA_KAFKA_BOOTSTRAP_SERVERS=cambiar
CATEDRA_KAFKA_GROUP_ID=cambiar
CATEDRA_KAFKA_APPOINTMENT_ACTIONS_TOPIC=cambiar

